const footerAd = () => {
  const result = document.createElement('div');
  result.className = 'dontpad-free footer-div';
  // TODO: do not user innerHTML
  result.innerHTML = `
  <div class="ad-btns-menu-footer">
			<button class="btn-open-modal" onclick="removeAndRenderBuyModal()">Remove All Ads</button>
		</div>

		<div class="footer-content">
      <!-- FooterResponsive -->
      <ins class="adsbygoogle footer-ad"
        style="display:block"
        data-ad-client="ca-pub-2087915935349742"
        data-ad-slot="5701473496">
      </ins>
		</div>
  </div>
  `;

  return result;
}

const footerRemoveAdsButton = () => {
  const buttonContainer = document.createElement('div');
  buttonContainer.className = 'ad-btns-menu-footer';

  const removeAdsButton = document.createElement('button');
  removeAdsButton.className = 'btn-open-modal';
  removeAdsButton.textContent = 'Remove All Ads';
  removeAdsButton.addEventListener('click', removeAndRenderBuyModal);

  buttonContainer.appendChild(removeAdsButton);

  return buttonContainer;
}

const cleverRemoveAdsButton = () => {
  const buttonContainer = document.createElement('div');
  buttonContainer.className = 'ad-btns-menu-clever';

  const removeAdsButton = document.createElement('button');
  removeAdsButton.className = 'btn-open-modal';
  removeAdsButton.textContent = 'Remove All Ads';
  removeAdsButton.addEventListener('click', removeAndRenderBuyModal);

  buttonContainer.appendChild(removeAdsButton);

  return buttonContainer;
}

const displayFooterAdIfMissing = () => {
  if (!document.querySelector('.footer-div')) {
    displayFooterAd();
    positionAbsoluteElements();
  }
}

const removeCleverAdsOnAlternative = (adContainer, iframe) => {
  const handleMessage = (ev) => {
    if (ev.source !== iframe.contentWindow) return;
    if (ev.data.type !== 'dontpad-remove-cleverads') return;

    adContainer.remove();
    displayFooterAdIfMissing();
    window.removeEventListener('message', handleMessage);
  };

  window.addEventListener('message', handleMessage);
}

const leftAd = () => {
  const result = document.createElement('div');
  result.className = 'dontpad-free left-menu-div';
  // TODO: do not user innerHTML
  result.innerHTML = `
  <button class="btn-menu" onclick="removeAndRenderBuyModal()"> Remove All Ads </button>

  <!-- LeftResponsive -->
  <div class="ad-div-left">
    <ins class="adsbygoogle left-ad"
      style="display:block"
      data-ad-client="ca-pub-2087915935349742"
      data-ad-slot="7753207178">
    </ins>
  </div>
  `;

  return result;
}

